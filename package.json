{
  "name": "openbeam-player-sdk",
  "version": "0.1.0",
  "description": "Embed the OpenBeam Cloud player in your own app: start sessions from your server, mount the player in your page, follow its state.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  },
  "keywords": [
    "openbeam",
    "cloud",
    "player",
    "embed",
    "simulation",
    "sdk"
  ],
  "homepage": "https://openbeam.world/docs/"
}
